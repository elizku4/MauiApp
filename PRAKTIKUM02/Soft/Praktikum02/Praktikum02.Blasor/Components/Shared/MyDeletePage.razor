@using System.Reflection
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>@PageTitleText</PageTitle>

<h1>@PageTitleText</h1>

<h3>Are you sure you want to delete this?</h3>

@if (Entity == null)
{
    <p>Loading...</p>
}
else
{
    <dl class="row">
        @foreach (var prop in VisibleProperties)
        {
            <dt class="col-sm-2">@prop.Name</dt>
            <dd class="col-sm-10">@FormatValue(prop.GetValue(Entity))</dd>
        }
    </dl>

    <EditForm Model="@Entity" OnSubmit="@HandleSubmit">
        <button class="btn btn-danger" type="submit">Delete</button>
        <a class="btn btn-secondary ms-2" href="@BasePath">Cancel</a>
    </EditForm>
}

@code {
    [Parameter] public string PageTitleText { get; set; } = "";
    [Parameter] public string EntityTitle { get; set; } = "";
    [Parameter] public object? Entity { get; set; }
    [Parameter] public string BasePath { get; set; } = "";
    [Parameter] public EventCallback OnValidSubmit { get; set; }

    private List<PropertyInfo> VisibleProperties =>
        Entity == null
            ? new List<PropertyInfo>()
            : Entity.GetType()
                .GetProperties()
                .Where(p => p.Name != "Id"
                         && p.Name != "Timestamp")
                .ToList();

    private async Task HandleSubmit()
    {
        await OnValidSubmit.InvokeAsync();
    }

    private static string FormatValue(object? value)
    {
        if (value == null)
            return "";

        if (value is DateTime date)
            return date == default ? "" : date.ToString("dd.MM.yyyy");

        if (value is double d)
            return d.ToString("0.##");

        if (value is decimal m)
            return m.ToString("0.##");

        if (value is Guid g)
            return g == Guid.Empty ? "" : g.ToString();

        return value.ToString() ?? "";
    }
}