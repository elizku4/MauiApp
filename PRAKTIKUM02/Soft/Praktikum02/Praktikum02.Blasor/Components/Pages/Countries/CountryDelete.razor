@rendermode InteractiveServer
@page "/countries/delete"
@using Praktikum02.Blasor.Data
@using Praktikum02.Blasor.Domain
@inject ICountriesRepo repo
@inject NavigationManager NavigationManager

<MyDeletePage PageTitleText="Delete Country"
              EntityTitle="Country"
              Entity="@item"
              BasePath="/countries"
              OnValidSubmit="delete" />

@code {
    [SupplyParameterFromQuery]
    private Guid Id { get; set; }

    private Country? item;

    protected override async Task OnInitializedAsync()
    {
        item = await repo.GetAsync(Id);

        if (item is null)
        {
            NavigationManager.NavigateTo("/countries");
            return;
        }
    }

    private async Task delete()
    {
        await repo.DeleteAsync(item!.Id);
        NavigationManager.NavigateTo("/countries");
    }
}