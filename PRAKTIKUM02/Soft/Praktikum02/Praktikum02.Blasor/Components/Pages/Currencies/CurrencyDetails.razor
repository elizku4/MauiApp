@rendermode InteractiveServer
@page "/currencies/details"
@using Praktikum02.Blasor.Data
@using Praktikum02.Blasor.Domain
@inject ICurrenciesRepo repo
@inject NavigationManager NavigationManager

<MyDetailsPage PageTitleText="Details Currency"
               EntityTitle="Currency"
               Entity="@item"
               EntityId="@item?.Id"
               BasePath="/currencies" />

@code {
    [SupplyParameterFromQuery]
    private Guid Id { get; set; }

    private Currency? item;

    protected override async Task OnInitializedAsync()
    {
        item = await repo.GetAsync(Id);

        if (item is null)
        {
            NavigationManager.NavigateTo("/currencies");
            return;
        }
    }
}