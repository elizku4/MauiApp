@rendermode InteractiveServer
@page "/currencies/delete"
@using Praktikum02.Blasor.Data
@using Praktikum02.Blasor.Domain
@inject ICurrenciesRepo repo
@inject NavigationManager NavigationManager

<MyDeletePage PageTitleText="Delete Currency"
              EntityTitle="Currency"
              Entity="@item"
              BasePath="/currencies"
              OnValidSubmit="delete" />

@code {
    [SupplyParameterFromQuery]
    private Guid Id { get; set; }

    private Currency? item;

    protected override async Task OnInitializedAsync()
    {
        item = await repo.GetAsync(Id);

        if (item is null)
        {
            NavigationManager.NavigateTo("/currencies");
            return;
        }
    }

    private async Task delete()
    {
        await repo.DeleteAsync(item!.Id);
        NavigationManager.NavigateTo("/currencies");
    }
}