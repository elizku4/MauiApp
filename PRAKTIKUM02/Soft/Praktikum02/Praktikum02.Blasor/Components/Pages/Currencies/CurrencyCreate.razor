@rendermode InteractiveServer
@page "/currencies/create"
@using Praktikum02.Blasor.Data
@using Praktikum02.Blasor.Domain
@inject ICurrenciesRepo repo
@inject NavigationManager NavigationManager

<MyCreatePage Entity="@item"
              EntityTitle="Currency"
              BasePath="/currencies"
              OnValidSubmit="add" />

@code {
    private Currency item { get; set; } = new();

    protected override void OnInitialized()
    {
        item.ValidFrom = DateTime.Today;
        item.ValidTo = DateTime.Today;
    }

    private async Task add()
    {
        await repo.CreateAsync(item);
        NavigationManager.NavigateTo("/currencies");
    }
}