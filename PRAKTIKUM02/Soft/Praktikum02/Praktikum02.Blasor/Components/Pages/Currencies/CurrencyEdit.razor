@rendermode InteractiveServer
@page "/currencies/edit"
@using Praktikum02.Blasor.Data
@using Praktikum02.Blasor.Domain
@inject ICurrenciesRepo repo
@inject NavigationManager NavigationManager

<MyEditPage PageTitleText="Edit Currency"
            EntityTitle="@item?.Name"
            Entity="@item"
            BasePath="/currencies"
            EntityId="@Id"
            OnValidSubmit="update" />

@code {
    [SupplyParameterFromQuery]
    private Guid Id { get; set; }

    private Currency? item { get; set; }

    protected override async Task OnInitializedAsync()
    {
        item ??= await repo.GetAsync(Id);

        if (item is null)
        {
            NavigationManager.NavigateTo("/currencies");
            return;
        }
    }

    private async Task update()
    {
        await repo.UpdateAsync(item!);
        NavigationManager.NavigateTo("/currencies");
    }
}